@model ESMC.ELM.Web.Models.CreateEngineeringToolVersionViewModel

@{
    ViewData["Title"] = "Add Tool Version";
}

<div class="mb-4">
    <h2>Add Tool Version</h2>

    <p class="text-muted mb-0">
        Add a new version for
        <strong>@Model.ToolName</strong>.
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="EngineeringToolId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Version"
                           class="form-label"></label>

                    <input asp-for="Version"
                           class="form-control"
                           placeholder="e.g. 3.2.1" />

                    <span asp-validation-for="Version"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ReleaseDate"
                           class="form-label"></label>

                    <input asp-for="ReleaseDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="ReleaseDate"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="mb-3">
                <label asp-for="ExecutableReference"
                       class="form-label"></label>

                <input asp-for="ExecutableReference"
                       class="form-control"
                       placeholder="File path, repository, package or document reference" />

                <span asp-validation-for="ExecutableReference"
                      class="text-danger"></span>

                <div class="form-text">
                    Optional reference to where this tool version can be found.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ReleaseNotes"
                       class="form-label"></label>

                <textarea asp-for="ReleaseNotes"
                          class="form-control"
                          rows="5"
                          placeholder="Version changes, fixes, limitations or other notes"></textarea>

                <span asp-validation-for="ReleaseNotes"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                    Active
                </label>
            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Save Version
                </button>

                <a asp-controller="EngineeringTools"
                   asp-action="Details"
                   asp-route-id="@Model.EngineeringToolId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}