@model ESMC.ELM.Web.Models.EditSerialRangeViewModel

@{
    ViewData["Title"] = "Edit Serial Range";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Edit Serial Range</h2>
                <p class="text-muted mb-0">
                    Update serial range information.
                </p>
            </div>

            <a asp-controller="ProductionBatches"
               asp-action="Details"
               asp-route-id="@Model.ProductionBatchId"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card mb-3">
            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">
                        <strong>Production Batch</strong>
                        <div>@Model.BatchDisplay</div>
                    </div>

                    <div class="col-md-6">
                        <strong>Batch Quantity</strong>
                        <div>@Model.BatchQuantity.ToString("N0")</div>
                    </div>

                    <div class="col-md-6 mt-3">
                        <strong>Other Serial Ranges Quantity</strong>
                        <div>
                            @Model.OtherSerialRangesQuantity.ToString("N0")
                        </div>
                    </div>

                    <div class="col-md-6 mt-3">
                        <strong>Maximum Allowed Quantity</strong>
                        <div>
                            @Model.MaximumAllowedQuantity.ToString("N0")
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="Edit" method="post">

                    <input asp-for="SerialRangeId" type="hidden" />
                    <input asp-for="ProductionBatchId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="RecipientCompanyId"
                                   class="form-label"></label>

                            <select asp-for="RecipientCompanyId"
                                    asp-items="Model.Companies"
                                    class="form-select">

                                <option value="">
                                    -- Select Recipient Company --
                                </option>

                            </select>

                            <span asp-validation-for="RecipientCompanyId"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6"></div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="SerialFrom"
                                   class="form-label"></label>

                            <input asp-for="SerialFrom"
                                   class="form-control"
                                   maxlength="8"
                                   inputmode="numeric" />

                            <span asp-validation-for="SerialFrom"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="SerialTo"
                                   class="form-label"></label>

                            <input asp-for="SerialTo"
                                   class="form-control"
                                   maxlength="8"
                                   inputmode="numeric" />

                            <span asp-validation-for="SerialTo"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity"
                                   class="form-label"></label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   readonly />

                            <small class="text-muted">
                                Calculated automatically from the serial range.
                            </small>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Notes"
                                   class="form-label"></label>

                            <textarea asp-for="Notes"
                                      rows="3"
                                      class="form-control"></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        function calculateQuantity() {

            const serialFrom =
                document.getElementById("SerialFrom").value;

            const serialTo =
                document.getElementById("SerialTo").value;

            const quantity =
                document.getElementById("Quantity");

            if (
                /^\d{8}$/.test(serialFrom) &&
                /^\d{8}$/.test(serialTo)
            ) {
                const from = parseInt(serialFrom);
                const to = parseInt(serialTo);

                if (to > from) {
                    quantity.value = to - from + 1;
                }
                else {
                    quantity.value = "";
                }
            }
            else {
                quantity.value = "";
            }
        }

        document
            .getElementById("SerialFrom")
            .addEventListener("input", calculateQuantity);

        document
            .getElementById("SerialTo")
            .addEventListener("input", calculateQuantity);

    </script>
}