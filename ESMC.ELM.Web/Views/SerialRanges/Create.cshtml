@model ESMC.ELM.Web.Models.CreateSerialRangeViewModel

@{
    ViewData["Title"] = "Create Serial Range";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Create Serial Range</h2>
                <p class="text-muted mb-0">
                    Assign a serial number range to a production batch.
                </p>
            </div>

            @if (Model.ProductionBatchId > 0)
            {
                <a asp-controller="ProductionBatches"
                   asp-action="Details"
                   asp-route-id="@Model.ProductionBatchId"
                   class="btn btn-outline-secondary">
                    Back
                </a>
            }
            else
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>
            }
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="ProductionBatchId"
                                   class="form-label"></label>

                            <select asp-for="ProductionBatchId"
                                    asp-items="Model.ProductionBatches"
                                    class="form-select">

                                <option value="">
                                    -- Select Production Batch --
                                </option>

                            </select>

                            <span asp-validation-for="ProductionBatchId"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="RecipientCompanyId"
                                   class="form-label"></label>

                            <select asp-for="RecipientCompanyId"
                                    asp-items="Model.Companies"
                                    class="form-select">

                                <option value="">
                                    -- Select Recipient Company --
                                </option>

                            </select>

                            <span asp-validation-for="RecipientCompanyId"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="SerialFrom"
                                   class="form-label"></label>

                            <input asp-for="SerialFrom"
                                   class="form-control" />

                            <span asp-validation-for="SerialFrom"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="SerialTo"
                                   class="form-label"></label>

                            <input asp-for="SerialTo"
                                   class="form-control" />

                            <span asp-validation-for="SerialTo"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity"
                                   class="form-label"></label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   readonly />

                            <span asp-validation-for="Quantity"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Notes"
                                   class="form-label"></label>

                            <textarea asp-for="Notes"
                                      rows="3"
                                      class="form-control"></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Create Serial Range
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}