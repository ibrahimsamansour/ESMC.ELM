@model IEnumerable<ESMC.ELM.Domain.Entities.SerialRange>

@{
    ViewData["Title"] = "Serial Ranges";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Serial Ranges</h2>
        <p class="text-muted mb-0">
            View serial number ranges assigned to production batches.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Serial Range
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No serial ranges have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Batch</th>
                            <th>Recipient Company</th>
                            <th>Serial From</th>
                            <th>Serial To</th>
                            <th>Quantity</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.ProductionBatch.BatchNumber
                                    </strong>
                                </td>

                                <td>
                                    @(item.RecipientCompany == null
                                                                ? "-"
                                                                : item.RecipientCompany.CompanyName)
                                                                                                </td>

                                <td>
                                    @item.SerialFrom
                                </td>

                                <td>
                                    @item.SerialTo
                                </td>

                                <td>
                                    @item.Quantity.ToString("N0")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Notes)
                                                                ? "-"
                                                                : item.Notes)
                        </td>

                            </tr>
                                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>