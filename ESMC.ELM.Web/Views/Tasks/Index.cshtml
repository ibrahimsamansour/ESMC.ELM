@model ESMC.ELM.Web.Models.TasksBoardViewModel

@{
    ViewData["Title"] = "Tasks Board";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">Tasks Board</h2>
            <p class="text-muted mb-0">
                Track engineering activities, assignments and progress.
            </p>
        </div>

        <a asp-controller="Tasks"
           asp-action="Create"
           class="btn btn-primary px-4">
            + New Task
        </a>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Active Tasks</div>
                    <div class="fs-3 fw-bold">@Model.TotalTasks</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">To Do</div>
                    <div class="fs-3 fw-bold">@Model.ToDo.Count</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">In Progress</div>
                    <div class="fs-3 fw-bold">@Model.InProgress.Count</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Blocked</div>
                    <div class="fs-3 fw-bold">@Model.Blocked.Count</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tasks Board -->
    <div class="row g-3 align-items-start">

        <!-- TO DO -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-semibold">To Do</div>
                        <span class="badge bg-secondary rounded-pill">
                            @Model.ToDo.Count
                        </span>
                    </div>
                </div>

                <div class="card-body bg-light">
                    @if (!Model.ToDo.Any())
                    {
                        <div class="text-center text-muted small py-4">
                            No tasks
                        </div>
                    }

                    @foreach (var task in Model.ToDo)
                    {
                        <partial name="_TaskCard"
                                 model="task"
                                 view-data='new ViewDataDictionary(ViewData)
                                 {
                                     ["UserNames"] = Model.UserNames
                                 }' />
                    }
                </div>
            </div>
        </div>

        <!-- IN PROGRESS -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-semibold text-primary">In Progress</div>
                        <span class="badge bg-primary rounded-pill">
                            @Model.InProgress.Count
                        </span>
                    </div>
                </div>

                <div class="card-body bg-light">
                    @if (!Model.InProgress.Any())
                    {
                        <div class="text-center text-muted small py-4">
                            No tasks
                        </div>
                    }

                    @foreach (var task in Model.InProgress)
                    {
                        <partial name="_TaskCard"
                                 model="task"
                                 view-data='new ViewDataDictionary(ViewData)
                                 {
                                     ["UserNames"] = Model.UserNames
                                 }' />
                    }
                </div>
            </div>
        </div>

        <!-- BLOCKED -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-semibold text-danger">Blocked</div>
                        <span class="badge bg-danger rounded-pill">
                            @Model.Blocked.Count
                        </span>
                    </div>
                </div>

                <div class="card-body bg-light">
                    @if (!Model.Blocked.Any())
                    {
                        <div class="text-center text-muted small py-4">
                            No tasks
                        </div>
                    }

                    @foreach (var task in Model.Blocked)
                    {
                        <partial name="_TaskCard"
                                 model="task"
                                 view-data='new ViewDataDictionary(ViewData)
                                 {
                                     ["UserNames"] = Model.UserNames
                                 }' />
                    }
                </div>
            </div>
        </div>

        <!-- DONE -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-semibold text-success">Done</div>
                        <span class="badge bg-success rounded-pill">
                            @Model.Done.Count
                        </span>
                    </div>
                </div>

                <div class="card-body bg-light">
                    @if (!Model.Done.Any())
                    {
                        <div class="text-center text-muted small py-4">
                            No tasks
                        </div>
                    }

                    @foreach (var task in Model.Done)
                    {
                        <partial name="_TaskCard"
                                 model="task"
                                 view-data='new ViewDataDictionary(ViewData)
                                 {
                                     ["UserNames"] = Model.UserNames
                                 }' />
                    }
                </div>
            </div>
        </div>

    </div>
</div>
