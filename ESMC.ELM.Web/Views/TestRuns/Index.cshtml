@model IEnumerable<ESMC.ELM.Domain.Entities.TestRun>

@{
    ViewData["Title"] = "Test Runs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Test Runs</h2>
        <p class="text-muted mb-0">
            Manage test execution cycles and validation runs.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Test Run
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No test runs have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Title</th>
                            <th>Project</th>
                            <th>Configuration</th>
                            <th>Firmware</th>
                            <th>Type</th>
                            <th>Start Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @item.TestRunCode
                                    </strong>
                                </td>

                                <td>
                                    @item.Title
                                </td>

                                <td>
                                    <strong>
                                        @item.Project.ProjectCode
                                    </strong>
                                </td>

                                <td>
                                    @if (item.ProjectConfiguration != null)
                                    {
                                        @item.ProjectConfiguration.ConfigurationCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @if (item.FirmwareRelease != null)
                                    {
                                        @item.FirmwareRelease.Version
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @item.TestType
                                </td>

                                <td>
                                    @item.StartDate.ToString("dd-MMM-yyyy HH:mm")
                                </td>

                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (item.Status == "InProgress")
                                    {
                                        <span class="badge bg-primary">
                                            In Progress
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Planned
                                        </span>
                                    }
                                </td>

                                <td class="text-nowrap">
                                    <a asp-action="Details"
                                       asp-route-id="@item.TestRunId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.TestRunId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>