@model ESMC.ELM.Web.Models.TestCasesImportViewModel
@{
    ViewData["Title"] = "Test Cases Import Preview";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3>Test Cases Import Preview</h3><p class="text-muted">File: @Model.FileName</p></div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Import</a>
    </div>
    <div class="row mb-3">
        <div class="col-md-4"><div class="card p-3">Total Rows: <strong>@Model.TotalRows</strong></div></div>
        <div class="col-md-4"><div class="card p-3">Valid Rows: <strong class="text-success">@Model.ValidRows</strong></div></div>
        <div class="col-md-4"><div class="card p-3">Invalid Rows: <strong class="text-danger">@Model.InvalidRows</strong></div></div>
    </div>
    @if (Model.InvalidRows > 0)
    {
        <div class="alert alert-warning">Validation failed. Correct the invalid rows and upload again.</div>
    }
    else
    {
        <div class="alert alert-success">Validation successful. All rows passed.</div>
    }
    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle">
                <thead><tr><th>Excel Row</th><th>Test Case Code</th><th>Project</th><th>Requirement</th><th>Function</th><th>Type</th><th>Title</th><th>Priority</th><th>Status</th><th>Validation</th></tr></thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr class="@(row.IsValid ? "" : "table-danger")">
                        <td>@row.RowNumber</td><td>@row.TestCaseCode</td><td>@row.ProjectCode</td><td>@row.RequirementCode</td><td>@row.FunctionCode</td><td>@row.TestType</td><td>@row.Title</td><td>@row.Priority</td><td>@row.Status</td>
                        <td>
                            @if (row.IsValid) { <span class="badge bg-success">Valid</span> }
                            else
                            {
                                <span class="badge bg-danger">Invalid</span>
                                <ul class="text-danger mb-0 ps-3">@foreach (var error in row.Errors) { <li>@error</li> }</ul>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.InvalidRows == 0 && Model.TotalRows > 0 && !string.IsNullOrWhiteSpace(Model.ImportToken))
    {
        <form asp-action="ConfirmImport" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="importToken" value="@Model.ImportToken" />
            <button type="submit" class="btn btn-success">Confirm Import (@Model.TotalRows Test Cases)</button>
        </form>
    }
</div>
