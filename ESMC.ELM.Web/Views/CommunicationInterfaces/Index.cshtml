@model IEnumerable<ESMC.ELM.Domain.Entities.CommunicationInterface>

@{
    ViewData["Title"] = "Communication Interfaces";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Communication Interfaces</h2>
        <p class="text-muted mb-0">
            Manage supported communication interfaces.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Communication Interface
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No communication interfaces have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Name</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "-"
                                        : item.Description)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>