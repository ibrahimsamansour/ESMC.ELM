@model ESMC.ELM.Web.Models.CreateCommunicationInterfaceViewModel

@{
    ViewData["Title"] = "Add Communication Interface";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Add Communication Interface</h2>
                <p class="text-muted mb-0">
                    Add a supported communication interface.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name"
                               class="form-label"></label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. RS485" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Add Communication Interface
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}