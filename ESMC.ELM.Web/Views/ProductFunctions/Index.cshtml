@model IEnumerable<ESMC.ELM.Domain.Entities.ProductFunction>

@{
    ViewData["Title"] = "Product Functions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Product Functions</h2>
        <p class="text-muted mb-0">
            Manage the engineering knowledge base for product functions.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Product Function
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No product functions have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Function Code</th>
                            <th>Function Name</th>
                            <th>Category</th>
                            <th>Purpose</th>
                            <th>Status</th>
                            <th style="width: 160px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.FunctionCode</strong>
                                </td>

                                <td>
                                    @item.FunctionName
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Category)
                                        ? "-"
                                        : item.Category)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Purpose)
                                        ? "-"
                                        : item.Purpose)
                                </td>

                                <td>
                                    @if (string.Equals(
                                   item.Status,
                                   "Active",
                                   StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Status,
                                    "Deprecated",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Deprecated
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.ProductFunctionId"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ProductFunctionId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>