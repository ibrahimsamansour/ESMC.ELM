@model ESMC.ELM.Domain.Entities.ProductFunction

@{
    ViewData["Title"] = "Product Function Details";
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Product Function Details</h2>
                <p class="text-muted mb-0">
                    View engineering knowledge for this product function.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h4 class="mb-1">
                            @Model.FunctionCode
                        </h4>

                        <div class="text-muted">
                            @Model.FunctionName
                        </div>
                    </div>

                    @if (string.Equals(
                    Model.Status,
                    "Active",
                    StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Category</label>
                        <div>
                            @(string.IsNullOrWhiteSpace(Model.Category)
                                ? "-"
                                : Model.Category)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Status</label>
                        <div>
                            @Model.Status
                        </div>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="text-muted">Purpose</label>
                        <div>
                            @(string.IsNullOrWhiteSpace(Model.Purpose)
                                ? "-"
                                : Model.Purpose)
                        </div>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="text-muted">Description</label>
                        <div>
                            @Model.Description
                        </div>
                    </div>

                    <div class="col-12">
                        <hr />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Created At</label>
                        <div>
                            @Model.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Last Updated</label>
                        <div>
                            @(Model.UpdatedAt.HasValue
                                ? Model.UpdatedAt.Value.ToString("dd-MMM-yyyy HH:mm")
                                : "-")
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>