@model ESMC.ELM.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Engineering Lifecycle Dashboard";
}

<div class="elm-dashboard dashboard-v2">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="dashboard-hero dashboard-hero-v2">

        <div class="dashboard-hero-overlay"></div>
        <div class="dashboard-hero-grid"></div>

        <div class="dashboard-hero-content">

            <!-- LEFT -->
            <div class="dashboard-hero-copy">

                <div class="dashboard-eyebrow">
                    ESMC ENGINEERING LIFECYCLE MANAGEMENT
                </div>

                <h1>
                    Smart Meter Engineering,
                    <span>Connected End to End.</span>
                </h1>

                <p class="dashboard-hero-description">
                    A unified engineering platform for managing the complete smart meter
                    lifecycle — from product definition and requirements through testing,
                    production and field service.
                </p>

                <div class="hero-lifecycle-tags">

                    <div class="hero-tag hero-tag-project">
                        <span class="hero-tag-icon">◇</span>
                        <span>Projects</span>
                    </div>

                    <div class="hero-tag hero-tag-requirement">
                        <span class="hero-tag-icon">▤</span>
                        <span>Requirements</span>
                    </div>

                    <div class="hero-tag hero-tag-testing">
                        <span class="hero-tag-icon">△</span>
                        <span>Testing &amp; Quality</span>
                    </div>

                    <div class="hero-tag hero-tag-production">
                        <span class="hero-tag-icon">▥</span>
                        <span>Production</span>
                    </div>

                    <div class="hero-tag hero-tag-service">
                        <span class="hero-tag-icon">⌁</span>
                        <span>Service</span>
                    </div>

                </div>

            </div>


            <!-- RIGHT / METER -->
            <div class="dashboard-meter-visual">

                <div class="meter-visual-ring meter-ring-one"></div>
                <div class="meter-visual-ring meter-ring-two"></div>

                <img src="~/images/dashboard/cl730s22.png"
                     asp-append-version="true"
                     class="dashboard-meter-image"
                     alt="ESMC CL730S22 Smart Meter" />

                <div class="meter-caption">
                    <strong>CL730S22</strong>
                    <span>Three Phase Smart Energy Meter</span>
                </div>

            </div>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- KPI CARDS -->
    <!-- ========================================================= -->

    <section class="dashboard-kpis">

        <!-- ACTIVE PROJECTS -->
        <a asp-controller="Projects"
           asp-action="Index"
           class="dashboard-kpi-card kpi-card-project">

            <div class="kpi-icon">
                ◇
            </div>

            <div class="kpi-main">

                <strong class="kpi-value">
                    @Model.ActiveProjects
                </strong>

                <span class="kpi-label">
                    Active Projects
                </span>

                <small>
                    @Model.TotalProjects total projects
                </small>

            </div>

            <div class="kpi-bars">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </a>


        <!-- METER MODELS -->
        <a asp-controller="MeterModels"
           asp-action="Index"
           class="dashboard-kpi-card kpi-card-model">

            <div class="kpi-icon">
                ▣
            </div>

            <div class="kpi-main">

                <strong class="kpi-value">
                    @Model.MeterModels
                </strong>

                <span class="kpi-label">
                    Meter Models
                </span>

                <small>
                    Product configurations
                </small>

            </div>

            <div class="kpi-bars">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </a>


        <!-- REQUIREMENTS -->
        <a asp-controller="Requirements"
           asp-action="Index"
           class="dashboard-kpi-card kpi-card-requirements">

            <div class="kpi-icon">
                ▤
            </div>

            <div class="kpi-main">

                <strong class="kpi-value">
                    @Model.Requirements
                </strong>

                <span class="kpi-label">
                    Total Requirements
                </span>

                <small>
                    Engineering requirements
                </small>

            </div>

            <div class="kpi-bars">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </a>


        <!-- OPEN DEFECTS -->
        <a asp-controller="Defects"
           asp-action="Index"
           class="dashboard-kpi-card kpi-card-defects">

            <div class="kpi-icon">
                !
            </div>

            <div class="kpi-main">

                <strong class="kpi-value">
                    @Model.OpenDefects
                </strong>

                <span class="kpi-label">
                    Open Defects
                </span>

                <small>
                    @Model.TotalDefects total defects
                </small>

            </div>

            <div class="kpi-bars">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </a>


        <!-- PRODUCTION BATCHES -->
        <a asp-controller="ProductionBatches"
           asp-action="Index"
           class="dashboard-kpi-card kpi-card-production">

            <div class="kpi-icon">
                ▥
            </div>

            <div class="kpi-main">

                <strong class="kpi-value">
                    @Model.ProductionBatches
                </strong>

                <span class="kpi-label">
                    Production Batches
                </span>

                <small>
                    @Model.ProductionOrders production orders
                </small>

            </div>

            <div class="kpi-bars">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </a>


        <!-- SERVICE REQUESTS -->
        <a asp-controller="ServiceRequests"
           asp-action="Index"
           class="dashboard-kpi-card kpi-card-service">

            <div class="kpi-icon">
                ⌁
            </div>

            <div class="kpi-main">

                <strong class="kpi-value">
                    @Model.OpenServiceRequests
                </strong>

                <span class="kpi-label">
                    Open Service Requests
                </span>

                <small>
                    @Model.ServiceRequests total requests
                </small>

            </div>

            <div class="kpi-bars">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

        </a>

    </section>


    <!-- ========================================================= -->
    <!-- ENGINEERING LIFECYCLE -->
    <!-- ========================================================= -->

    <section class="lifecycle-card lifecycle-card-v2">

        <div class="lifecycle-header">

            <h2>
                Engineering Lifecycle
            </h2>

            <span>
                Integrated management across the entire smart meter lifecycle
            </span>

        </div>


        <div class="lifecycle-flow">

            <!-- PROJECTS -->
            <div class="lifecycle-step lifecycle-project">

                <div class="lifecycle-icon-row">

                    <span class="lifecycle-number">
                        01
                    </span>

                    <div class="lifecycle-icon">
                        ◇
                    </div>

                </div>

                <strong>
                    Projects &amp; Product
                </strong>

                <span class="lifecycle-description">
                    Define products, configurations
                    <br />
                    and meter models
                </span>

            </div>


            <div class="lifecycle-connector">
                <span>→</span>
            </div>


            <!-- REQUIREMENTS -->
            <div class="lifecycle-step lifecycle-requirement">

                <div class="lifecycle-icon-row">

                    <span class="lifecycle-number">
                        02
                    </span>

                    <div class="lifecycle-icon">
                        ▤
                    </div>

                </div>

                <strong>
                    Requirements
                </strong>

                <span class="lifecycle-description">
                    Manage and trace
                    <br />
                    engineering requirements
                </span>

            </div>


            <div class="lifecycle-connector">
                <span>→</span>
            </div>


            <!-- TESTING -->
            <div class="lifecycle-step lifecycle-testing">

                <div class="lifecycle-icon-row">

                    <span class="lifecycle-number">
                        03
                    </span>

                    <div class="lifecycle-icon">
                        △
                    </div>

                </div>

                <strong>
                    Testing &amp; Quality
                </strong>

                <span class="lifecycle-description">
                    Test cases, test runs,
                    <br />
                    results and defect management
                </span>

            </div>


            <div class="lifecycle-connector">
                <span>→</span>
            </div>


            <!-- PRODUCTION -->
            <div class="lifecycle-step lifecycle-production">

                <div class="lifecycle-icon-row">

                    <span class="lifecycle-number">
                        04
                    </span>

                    <div class="lifecycle-icon">
                        ▥
                    </div>

                </div>

                <strong>
                    Production
                </strong>

                <span class="lifecycle-description">
                    Production orders,
                    <br />
                    batches and quality records
                </span>

            </div>


            <div class="lifecycle-connector">
                <span>→</span>
            </div>


            <!-- SERVICE -->
            <div class="lifecycle-step lifecycle-service">

                <div class="lifecycle-icon-row">

                    <span class="lifecycle-number">
                        05
                    </span>

                    <div class="lifecycle-icon">
                        ⌁
                    </div>

                </div>

                <strong>
                    Service &amp; Maintenance
                </strong>

                <span class="lifecycle-description">
                    Field service requests,
                    <br />
                    inspections, repairs and results
                </span>

            </div>

        </div>


        <!-- SUPPORTING RESOURCES -->
        <div class="lifecycle-support">

            <div class="support-title">
                Supporting Engineering Resources
            </div>


            <a asp-controller="ProductFunctions"
               asp-action="Index"
               class="support-resource">

                <span class="support-icon support-functions">
                    ▤
                </span>

                <div>
                    <strong>
                        Functions Knowledge
                    </strong>

                    <small>
                        Product functions, versions and knowledge files
                    </small>
                </div>

            </a>


            <a asp-controller="EngineeringTools"
               asp-action="Index"
               class="support-resource">

                <span class="support-icon support-tools">
                    ⌘
                </span>

                <div>
                    <strong>
                        Engineering Tools
                    </strong>

                    <small>
                        Tools, versions and supported meter models
                    </small>
                </div>

            </a>

        </div>

    </section>


    <!-- ========================================================= -->
    <!-- OPERATIONAL OVERVIEW -->
    <!-- ========================================================= -->

    <section class="operational-section">

        <div class="operational-heading">

            <h2>
                Operational Overview
            </h2>

            <span>
                Current engineering, quality, production and service activity.
            </span>

        </div>


        <div class="operational-grid">


            <!-- ================================================= -->
            <!-- RECENT PROJECTS -->
            <!-- ================================================= -->

            <article class="operational-card">

                <div class="operational-card-header">

                    <div class="operational-title">

                        <span class="operational-icon icon-project">
                            ◇
                        </span>

                        <strong>
                            Recent Projects
                        </strong>

                    </div>

                    <a asp-controller="Projects"
                       asp-action="Index">
                        View all →
                    </a>

                </div>


                <div class="operational-table-wrapper">

                    <table class="operational-table">

                        <thead>
                            <tr>
                                <th>Project Code</th>
                                <th>Project Name</th>
                                <th>Status</th>
                                <th>Priority</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.RecentProjects.Any())
                            {
                                @foreach (var project in Model.RecentProjects)
                                {
                                    var projectStatusClass =
                                    project.Status?.ToLowerInvariant() switch
                                    {
                                        "active" => "status-success",
                                        "planning" => "status-warning",
                                        "on hold" => "status-danger",
                                        "onhold" => "status-danger",
                                        "completed" => "status-success",
                                        _ => "status-neutral"
                                    };

                                    <tr>

                                        <td>
                                            <a asp-controller="Projects"
                                               asp-action="Details"
                                               asp-route-id="@project.ProjectId"
                                               class="table-primary-link">

                                                @project.ProjectCode

                                            </a>
                                        </td>

                                        <td>
                                            @project.ProjectName
                                        </td>

                                        <td>
                                            <span class="table-status @projectStatusClass">
                                                @project.Status
                                            </span>
                                        </td>

                                        <td>
                                            @project.Priority
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4"
                                        class="operational-empty">

                                        No projects available.

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- TESTING & QUALITY -->
            <!-- ================================================= -->

            <article class="operational-card">

                <div class="operational-card-header">

                    <div class="operational-title">

                        <span class="operational-icon icon-testing">
                            △
                        </span>

                        <strong>
                            Testing &amp; Quality
                        </strong>

                    </div>

                    <a asp-controller="TestRuns"
                       asp-action="Index">
                        View all →
                    </a>

                </div>


                <div class="quality-operational-body">

                    <div class="quality-operational-stat">

                        <span>
                            Test Runs
                        </span>

                        <strong>
                            @Model.TestRuns
                        </strong>

                    </div>


                    <div class="quality-operational-stat">

                        <span>
                            Open Defects
                        </span>

                        <strong>
                            @Model.OpenDefects
                        </strong>

                    </div>


                    <div class="quality-operational-stat">

                        <span>
                            Total Defects
                        </span>

                        <strong>
                            @Model.TotalDefects
                        </strong>

                    </div>

                </div>


                <div class="operational-summary-row">

                    <span class="summary-icon summary-quality">
                        ✓
                    </span>

                    <div>

                        <strong>
                            Quality Management
                        </strong>

                        <small>
                            Test execution, results and defect management
                        </small>

                    </div>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- PRODUCTION STATUS -->
            <!-- ================================================= -->

            <article class="operational-card">

                <div class="operational-card-header">

                    <div class="operational-title">

                        <span class="operational-icon icon-production">
                            ▥
                        </span>

                        <strong>
                            Production Status
                        </strong>

                    </div>

                    <a asp-controller="ProductionOrders"
                       asp-action="Index">
                        View all →
                    </a>

                </div>


                <div class="production-operational-body">

                    <a asp-controller="ProductionOrders"
                       asp-action="Index"
                       class="production-operational-stat">

                        <span class="production-mini-icon">
                            ◫
                        </span>

                        <div>
                            <strong>
                                @Model.ProductionOrders
                            </strong>

                            <span>
                                Production Orders
                            </span>
                        </div>

                    </a>


                    <a asp-controller="ProductionBatches"
                       asp-action="Index"
                       class="production-operational-stat">

                        <span class="production-mini-icon">
                            ▦
                        </span>

                        <div>
                            <strong>
                                @Model.ProductionBatches
                            </strong>

                            <span>
                                Production Batches
                            </span>
                        </div>

                    </a>

                </div>


                <div class="operational-summary-row">

                    <span class="summary-icon summary-production">
                        ⚙
                    </span>

                    <div>

                        <strong>
                            Manufacturing Control
                        </strong>

                        <small>
                            Production orders and batch management
                        </small>

                    </div>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- RECENT SERVICE REQUESTS -->
            <!-- ================================================= -->

            <article class="operational-card">

                <div class="operational-card-header">

                    <div class="operational-title">

                        <span class="operational-icon icon-service">
                            ⌁
                        </span>

                        <strong>
                            Recent Service Requests
                        </strong>

                    </div>

                    <a asp-controller="ServiceRequests"
                       asp-action="Index">
                        View all →
                    </a>

                </div>


                <div class="operational-table-wrapper">

                    <table class="operational-table service-table">

                        <thead>
                            <tr>
                                <th>Request No.</th>
                                <th>Meter S/N</th>
                                <th>Status</th>
                                <th>Priority</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.RecentServiceRequests.Any())
                            {
                                @foreach (var request in Model.RecentServiceRequests)
                                {
                                    var serviceStatusClass =
                                    request.Status?.ToLowerInvariant() switch
                                    {
                                        "closed" => "status-success",
                                        "readyforreturn" => "status-success",
                                        "ready for return" => "status-success",
                                        "inrepair" => "status-info",
                                        "in repair" => "status-info",
                                        "inspection" => "status-warning",
                                        "open" => "status-danger",
                                        _ => "status-neutral"
                                    };

                                    <tr>

                                        <td>
                                            <a asp-controller="ServiceRequests"
                                               asp-action="Details"
                                               asp-route-id="@request.ServiceRequestId"
                                               class="table-primary-link">

                                                @request.ServiceRequestNumber

                                            </a>
                                        </td>

                                        <td>
                                            @request.MeterSerialNumber
                                        </td>

                                        <td>
                                            <span class="table-status @serviceStatusClass">
                                                @request.Status
                                            </span>
                                        </td>

                                        <td>
                                            @request.Priority
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4"
                                        class="operational-empty">

                                        No service requests available.

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </article>

        </div>

    </section>

</div>