@model ESMC.ELM.Web.Models.SerialTraceabilityViewModel

@{
    ViewData["Title"] = "Serial Traceability";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Serial Traceability</h2>
        <p class="text-muted mb-0">
            Search by meter serial number to trace its production history.
        </p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <div class="row align-items-end">

                <div class="col-md-6">

                    <label asp-for="SerialNumber"
                           class="form-label">
                        Serial Number
                    </label>

                    <input asp-for="SerialNumber"
                           class="form-control"
                           maxlength="8"
                           inputmode="numeric"
                           placeholder="Enter 8-digit serial number" />

                    <span asp-validation-for="SerialNumber"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-3 mt-3 mt-md-0">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>

                </div>

            </div>

        </form>

    </div>
</div>

@if (Model.SearchPerformed)
{
    if (Model.SerialRange == null)
    {
        if (ViewData.ModelState.IsValid)
        {
            <div class="alert alert-warning">
                No production traceability information was found
                for serial number
                <strong>@Model.SerialNumber</strong>.
            </div>
        }
    }
    else
    {
        <div class="alert alert-success">
            Serial number
            <strong>@Model.SerialNumber</strong>
            was found successfully.
        </div>

        <!-- ================================================= -->
        <!-- SERIAL INFORMATION                                -->
        <!-- ================================================= -->

        <div class="card mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Serial Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <strong>Serial Number</strong>
                        <div>
                            @Model.SerialNumber
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <strong>Serial Range</strong>
                        <div>
                            @Model.SerialRange.SerialFrom
                            -
                            @Model.SerialRange.SerialTo
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <strong>Range Quantity</strong>
                        <div>
                            @Model.SerialRange.Quantity.ToString("N0")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Recipient Company</strong>
                        <div>
                            @(Model.RecipientCompany == null
                                                ? "-"
                                                : Model.RecipientCompany.CompanyName)
                                                                                 </div>
                                                                             </div>

                    <div class="col-md-6 mb-3">
                        <strong>Notes</strong>
                        <div>
                            @(string.IsNullOrWhiteSpace(
                                                Model.SerialRange.Notes)
                                                ? "-"
                                                : Model.SerialRange.Notes)
                                                                      </div>
                                                                  </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PRODUCTION BATCH                                  -->
        <!-- ================================================= -->

        <div class="card mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Production Batch
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <strong>Batch Number</strong>

                        <div>
                            <a asp-controller="ProductionBatches"
                               asp-action="Details"
                               asp-route-id="@Model.ProductionBatch!.ProductionBatchId">
                                @Model.ProductionBatch.BatchNumber
                            </a>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <strong>Batch Quantity</strong>
                        <div>
                            @Model.ProductionBatch.BatchQuantity.ToString("N0")
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <strong>Production Line</strong>
                        <div>
                            @(string.IsNullOrWhiteSpace(
                                                Model.ProductionBatch.ProductionLine)
                                                ? "-"
                                                : Model.ProductionBatch.ProductionLine)
                                                                                   </div>
                                                                               </div>

                    <div class="col-md-4 mb-3">
                        <strong>Production Date</strong>
                        <div>
                            @(Model.ProductionBatch.ProductionDate?
                                                .ToString("dd-MMM-yyyy") ?? "-")
                </div>
            </div>

                    <div class="col-md-4 mb-3">
                        <strong>Batch Status</strong>
                        <div>
                            @Model.ProductionBatch.BatchStatus
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <strong>Batch Decision</strong>
                        <div>
                            @Model.ProductionBatch.BatchDecision
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PRODUCTION ORDER                                  -->
        <!-- ================================================= -->

        <div class="card mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Production Order
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <strong>Order Number</strong>
                        <div>
                            @Model.ProductionOrder!.ProductionOrderNumber
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <strong>Planned Quantity</strong>
                        <div>
                            @Model.ProductionOrder.PlannedQuantity.ToString("N0")
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <strong>Status</strong>
                        <div>
                            @Model.ProductionOrder.Status
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- PROJECT CONFIGURATION                             -->
        <!-- ================================================= -->

        <div class="card mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Project Configuration
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <strong>Configuration Code</strong>
                        <div>
                            @Model.ProjectConfiguration!.ConfigurationCode
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Configuration Name</strong>
                        <div>
                            @Model.ProjectConfiguration.ConfigurationName
                        </div>
                    </div>

                </div>

            </div>

        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}