@model IEnumerable<ESMC.ELM.Domain.Entities.FunctionKnowledgeFile>

@{
    ViewData["Title"] = "Function Knowledge Files";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Function Knowledge Files</h2>
        <p class="text-muted mb-0">
            Manage engineering documents and knowledge files linked to product functions.
        </p>
    </div>

    <a asp-action="Upload"
       class="btn btn-primary">
        Upload File
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No knowledge files have been uploaded yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Function</th>
                            <th>Revision</th>
                            <th>File</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Uploaded</th>
                            <th style="width: 100px;">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.ProductFunction.FunctionCode
                                    </strong>

                                    <div class="small text-muted">
                                        @item.ProductFunction.FunctionName
                                    </div>
                                </td>

                                <td>
                                    @if (item.FunctionVersion != null)
                                    {
                                        <span class="badge bg-info text-dark">
                                            Rev @item.FunctionVersion.Revision
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            General
                                        </span>
                                    }
                                </td>

                                <td>
                                    <strong>
                                        @item.FileName
                                    </strong>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.FileType))
                                    {
                                        <span class="badge bg-secondary">
                                            @item.FileType
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td style="max-width: 300px;">
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "-"
                                        : item.Description)
                                </td>

                                <td>
                                    @item.UploadedAt.ToString("dd-MMM-yyyy HH:mm")
                                </td>

                                <td>
                                    <a href="@item.FilePath"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>