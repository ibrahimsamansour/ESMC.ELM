@model ESMC.ELM.Web.Models.UploadFunctionKnowledgeFileViewModel

@{
    ViewData["Title"] = "Upload Function Knowledge File";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Upload Knowledge File</h2>
                <p class="text-muted mb-0">
                    Upload engineering documents linked to a product function or specific revision.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="Upload"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProductFunctionId"
                               class="form-label"></label>

                        <select asp-for="ProductFunctionId"
                                asp-items="Model.ProductFunctions"
                                class="form-select">
                            <option value="">
                                -- Select Product Function --
                            </option>
                        </select>

                        <span asp-validation-for="ProductFunctionId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FunctionVersionId"
                               class="form-label"></label>

                        <select asp-for="FunctionVersionId"
                                asp-items="Model.FunctionVersions"
                                class="form-select">
                            <option value="">
                                -- General Function File --
                            </option>
                        </select>

                        <div class="form-text">
                            Optional. Leave empty if the file applies to the function generally.
                        </div>

                        <span asp-validation-for="FunctionVersionId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="File"
                               class="form-label"></label>

                        <input asp-for="File"
                               type="file"
                               class="form-control" />

                        <div class="form-text">
                            Maximum file size: 20 MB.
                        </div>

                        <span asp-validation-for="File"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the document or its purpose..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Upload File
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}