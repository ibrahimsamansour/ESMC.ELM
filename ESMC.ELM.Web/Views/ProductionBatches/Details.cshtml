@model ESMC.ELM.Domain.Entities.ProductionBatch

@using ESMC.ELM.Domain.Entities

@{
    ViewData["Title"] = "Production Batch Details";

    var qualityRecords =
        ViewBag.QualityRecords as List<BatchQualityRecord>
        ?? new List<BatchQualityRecord>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Production Batch Details</h2>
        <p class="text-muted mb-0">
            View production batch information and quality inspections.
        </p>
    </div>

    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.ProductionBatchId"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">
                <strong>Batch Number</strong>
                <div>@Model.BatchNumber</div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Production Order</strong>
                <div>
                    @Model.ProductionOrder.ProductionOrderNumber
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Project Configuration</strong>
                <div>
                    @Model.ProjectConfiguration.ConfigurationCode
                    -
                    @Model.ProjectConfiguration.ConfigurationName
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Batch Quantity</strong>
                <div>
                    @Model.BatchQuantity.ToString("N0")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Production Date</strong>
                <div>
                    @(Model.ProductionDate?
                                        .ToString("dd-MMM-yyyy") ?? "-")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Completion Date</strong>
                <div>
                    @(Model.CompletionDate?
                                        .ToString("dd-MMM-yyyy") ?? "-")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Production Line</strong>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.ProductionLine)
                                        ? "-"
                                        : Model.ProductionLine)
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Batch Status</strong>
                <div>
                    @Model.BatchStatus
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Batch Decision</strong>
                <div>
                    @Model.BatchDecision
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Decision Date</strong>
                <div>
                    @(Model.DecisionDate?
                                        .ToString("dd-MMM-yyyy") ?? "-")
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Decision By</strong>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.DecisionBy)
                                        ? "-"
                                        : Model.DecisionBy)
                </div>
            </div>

            <div class="col-12 mb-3">
                <strong>Rejection Reason</strong>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.RejectionReason)
                                        ? "-"
                                        : Model.RejectionReason)
                </div>
            </div>

            <div class="col-12 mb-3">
                <strong>Notes</strong>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                                        ? "-"
                                        : Model.Notes)
                </div>
            </div>

        </div>

        <hr />

        <div class="row text-muted small">

            <div class="col-md-6">
                Created:
                @Model.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
            </div>

            <div class="col-md-6">
                Last Updated:
                @(Model.UpdatedAt?
                                .ToString("dd-MMM-yyyy HH:mm") ?? "-")
            </div>

        </div>

    </div>
</div>

<!-- ========================================================= -->
<!-- QUALITY INSPECTION RECORDS                                -->
<!-- ========================================================= -->

<div class="card">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-0">
                    Quality Inspection Records
                </h5>

                <small class="text-muted">
                    Quality inspections performed on this production batch.
                </small>
            </div>

            <a asp-controller="BatchQualityRecords"
               asp-action="Create"
               asp-route-productionBatchId="@Model.ProductionBatchId"
               class="btn btn-sm btn-primary">
                Add Quality Record
            </a>

        </div>

    </div>

    <div class="card-body">

        @if (!qualityRecords.Any())
        {
            <div class="alert alert-info mb-0">
                No quality inspection records have been added
                for this batch yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Inspection Type</th>
                            <th>Inspection Date</th>
                            <th>Result</th>
                            <th>Report Reference</th>
                            <th>Comments</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var record in qualityRecords)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @record.InspectionType
                                    </strong>
                                </td>

                                <td>
                                    @record.InspectionDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>

                                    @if (record.Result == "Passed")
                                    {
                                        <span class="badge bg-success">
                                            Passed
                                        </span>
                                    }
                                    else if (record.Result == "Failed")
                                    {
                                        <span class="badge bg-danger">
                                            Failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Conditional
                                        </span>
                                    }

                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(
                                                            record.ReportReference)
                                                            ? "-"
                                                            : record.ReportReference)
                                                                                 </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(
                                                            record.Comments)
                                                            ? "-"
                                                            : record.Comments)
                        </td>

                            </tr>
                                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>