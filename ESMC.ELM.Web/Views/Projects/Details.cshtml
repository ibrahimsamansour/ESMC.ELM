@model ESMC.ELM.Domain.Entities.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Project Details</h2>
                <p class="text-muted mb-0">
                    View engineering project and contract information.
                </p>
            </div>

            <div>
                <a asp-action="Edit"
                   asp-route-id="@Model.ProjectId"
                   class="btn btn-primary">
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <h4 class="mb-4">
                    @Model.ProjectName
                </h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Project Code</label>
                        <div class="fw-semibold">
                            @Model.ProjectCode
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Customer</label>
                        <div class="fw-semibold">
                            @Model.CustomerName
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Country</label>
                        <div>
                            @(Model.Country ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Contract Number</label>
                        <div>
                            @(Model.ContractNumber ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Contract Quantity</label>
                        <div>
                            @(Model.ContractQuantity?.ToString("N0") ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Status</label>
                        <div>
                            <span class="badge bg-primary">
                                @Model.Status
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Priority</label>
                        <div>
                            @Model.Priority
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Start Date</label>
                        <div>
                            @(Model.StartDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Planned End Date</label>
                        <div>
                            @(Model.PlannedEndDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Actual End Date</label>
                        <div>
                            @(Model.ActualEndDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </div>
                    </div>

                    <div class="col-12 mt-2">
                        <hr />

                        <label class="text-muted">Description</label>

                        <div class="mt-1">
                            @if (string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <span class="text-muted">
                                    No description provided.
                                </span>
                            }
                            else
                            {
                                @Model.Description
                            }
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>