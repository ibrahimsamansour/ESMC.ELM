@model List<ESMC.ELM.Domain.Entities.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Projects</h2>
        <p class="text-muted mb-0">
            Manage ESMC engineering projects and contract information.
        </p>
    </div>

    <a asp-controller="Projects"
       asp-action="Create"
       class="btn btn-primary">
        Add Project
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Project Code</th>
                        <th>Project Name</th>
                        <th>Customer</th>
                        <th>Country</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Start Date</th>
                        <th>Planned End</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var project in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@project.ProjectCode</strong>
                                </td>

                                <td>
                                    @project.ProjectName
                                </td>

                                <td>
                                    @project.CustomerName
                                </td>

                                <td>
                                    @project.Country
                                </td>

                                <td>
                                    @(project.ContractQuantity?.ToString("N0") ?? "-")
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @project.Status
                                    </span>
                                </td>

                                <td>
                                    @project.Priority
                                </td>

                                <td>
                                    @(project.StartDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>
                                    @(project.PlannedEndDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>
                                    <a asp-controller="Projects"
                                       asp-action="Details"
                                       asp-route-id="@project.ProjectId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-controller="Projects"
                                       asp-action="Edit"
                                       asp-route-id="@project.ProjectId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">
                                No projects found.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>