@model ESMC.ELM.Web.Models.CreateServiceRepairViewModel

@{
    ViewData["Title"] = "Create Service Repair";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Create Service Repair</h2>
        <p class="text-muted mb-0">
            Record the repair action for the service request.
        </p>
    </div>

    <a asp-controller="ServiceRequests"
       asp-action="Details"
       asp-route-id="@Model.ServiceRequestId"
       class="btn btn-outline-secondary">
        Back
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <label class="text-muted small">
                    Service Request
                </label>
                <div class="fw-semibold">
                    @Model.ServiceRequestNumber
                </div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small">
                    Meter Serial Number
                </label>
                <div class="fw-semibold">
                    @Model.MeterSerialNumber
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">

        <form asp-action="Create" method="post">

            <input asp-for="ServiceRequestId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="RepairDate"
                           class="form-label"></label>

                    <input asp-for="RepairDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="RepairDate"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="RepairEngineerName"
                           class="form-label"></label>

                    <input asp-for="RepairEngineerName"
                           class="form-control" />

                    <span asp-validation-for="RepairEngineerName"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="RepairType"
                           class="form-label"></label>

                    <input asp-for="RepairType"
                           class="form-control"
                           placeholder="Example: Firmware, Hardware, Configuration" />

                    <span asp-validation-for="RepairType"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="RepairResult"
                           class="form-label"></label>

                    <input asp-for="RepairResult"
                           class="form-control"
                           placeholder="Example: Repaired, Failed, Pending Verification" />

                    <span asp-validation-for="RepairResult"
                          class="text-danger"></span>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="ActionTaken"
                           class="form-label"></label>

                    <textarea asp-for="ActionTaken"
                              rows="4"
                              class="form-control"></textarea>

                    <span asp-validation-for="ActionTaken"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="FirmwareBeforeId"
                           class="form-label"></label>

                    <select asp-for="FirmwareBeforeId"
                            asp-items="Model.FirmwareReleases"
                            class="form-select">

                        <option value="">
                            -- Select Firmware --
                        </option>

                    </select>

                    <span asp-validation-for="FirmwareBeforeId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="FirmwareAfterId"
                           class="form-label"></label>

                    <select asp-for="FirmwareAfterId"
                            asp-items="Model.FirmwareReleases"
                            class="form-select">

                        <option value="">
                            -- Select Firmware --
                        </option>

                    </select>

                    <span asp-validation-for="FirmwareAfterId"
                          class="text-danger"></span>
                </div>

                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input asp-for="ConfigurationChanged"
                               class="form-check-input" />

                        <label asp-for="ConfigurationChanged"
                               class="form-check-label"></label>
                    </div>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Notes"
                           class="form-label"></label>

                    <textarea asp-for="Notes"
                              rows="3"
                              class="form-control"></textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2">

                <a asp-controller="ServiceRequests"
                   asp-action="Details"
                   asp-route-id="@Model.ServiceRequestId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Save Repair
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}