@model IEnumerable<ESMC.ELM.Domain.Entities.Defect>

@{
    ViewData["Title"] = "Defects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Defects</h2>
        <p class="text-muted mb-0">
            Track defects across testing, production, and maintenance.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Defect
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No defects have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Title</th>
                            <th>Source</th>
                            <th>Severity</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Project</th>
                            <th>Reported Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.DefectCode</strong>
                                </td>

                                <td>
                                    @item.Title
                                </td>

                                <td>
                                    @item.Source
                                </td>

                                <td>
                                    @if (item.Severity == "Critical")
                                    {
                                        <span class="badge bg-danger">
                                            Critical
                                        </span>
                                    }
                                    else if (item.Severity == "High")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            High
                                        </span>
                                    }
                                    else if (item.Severity == "Medium")
                                    {
                                        <span class="badge bg-primary">
                                            Medium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Low
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.Priority
                                </td>

                                <td>
                                    @if (item.Status == "Closed")
                                    {
                                        <span class="badge bg-success">
                                            Closed
                                        </span>
                                    }
                                    else if (item.Status == "Resolved")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Resolved
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-dark">
                                            Rejected
                                        </span>
                                    }
                                    else if (item.Status == "InProgress")
                                    {
                                        <span class="badge bg-primary">
                                            In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Open
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Project != null)
                                    {
                                        @item.Project.ProjectCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>
                                    @item.ReportedDate.ToString("dd-MMM-yyyy HH:mm")
                                </td>

                                <td class="text-end text-nowrap">
                                    <a asp-action="Details"
                                       asp-route-id="@item.DefectId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.DefectId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>