@model ESMC.ELM.Web.Models.CreateDefectViewModel

@{
    ViewData["Title"] = "Add Defect";
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Add Defect</h2>
                <p class="text-muted mb-0">
                    Record a defect and its engineering context.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <label asp-for="DefectCode" class="form-label"></label>
                            <input asp-for="DefectCode" class="form-control" />
                            <span asp-validation-for="DefectCode"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Source" class="form-label"></label>
                            <select asp-for="Source" class="form-select">
                                <option value="Testing">Testing</option>
                                <option value="Production">Production</option>
                                <option value="Maintenance">Maintenance</option>
                            </select>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Severity" class="form-label"></label>
                            <select asp-for="Severity" class="form-select">
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Normal">Normal</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Open">Open</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Closed">Closed</option>
                                <option value="Rejected">Rejected</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectId" class="form-label"></label>
                            <select asp-for="ProjectId"
                                    asp-items="Model.Projects"
                                    class="form-select">
                                <option value="">-- No Project --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="TestResultId" class="form-label"></label>
                            <select asp-for="TestResultId"
                                    asp-items="Model.TestResults"
                                    class="form-select">
                                <option value="">-- No Test Result --</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="MeterModelId" class="form-label"></label>
                            <select asp-for="MeterModelId"
                                    asp-items="Model.MeterModels"
                                    class="form-select">
                                <option value="">-- No Meter Model --</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="FirmwareReleaseId"
                                   class="form-label"></label>
                            <select asp-for="FirmwareReleaseId"
                                    asp-items="Model.FirmwareReleases"
                                    class="form-select">
                                <option value="">-- No Firmware --</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="ProductFunctionId"
                                   class="form-label"></label>
                            <select asp-for="ProductFunctionId"
                                    asp-items="Model.ProductFunctions"
                                    class="form-select">
                                <option value="">-- No Product Function --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FunctionVersionId"
                                   class="form-label"></label>
                            <select asp-for="FunctionVersionId"
                                    asp-items="Model.FunctionVersions"
                                    class="form-select">
                                <option value="">-- No Function Version --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="AssignedToUserId"
                                   class="form-label"></label>
                            <select asp-for="AssignedToUserId"
                                    asp-items="Model.Users"
                                    class="form-select">
                                <option value="">-- Unassigned --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ReportedDate"
                                   class="form-label"></label>
                            <input asp-for="ReportedDate"
                                   type="datetime-local"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="VerificationStatus"
                                   class="form-label"></label>
                            <select asp-for="VerificationStatus"
                                    class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Passed">Passed</option>
                                <option value="Failed">Failed</option>
                            </select>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="ReproductionSteps"
                                   class="form-label"></label>
                            <textarea asp-for="ReproductionSteps"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpectedBehavior"
                                   class="form-label"></label>
                            <textarea asp-for="ExpectedBehavior"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ActualBehavior"
                                   class="form-label"></label>
                            <textarea asp-for="ActualBehavior"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="RootCause"
                                   class="form-label"></label>
                            <textarea asp-for="RootCause"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="FixDescription"
                                   class="form-label"></label>
                            <textarea asp-for="FixDescription"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FixFirmwareReleaseId"
                                   class="form-label"></label>
                            <select asp-for="FixFirmwareReleaseId"
                                    asp-items="Model.FirmwareReleases"
                                    class="form-select">
                                <option value="">-- No Fix Firmware --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ClosedDate"
                                   class="form-label"></label>
                            <input asp-for="ClosedDate"
                                   type="datetime-local"
                                   class="form-control" />
                        </div>

                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Save Defect
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}