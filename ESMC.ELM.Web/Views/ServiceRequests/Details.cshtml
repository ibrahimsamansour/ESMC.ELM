@model ESMC.ELM.Domain.Entities.ServiceRequest

@using ESMC.ELM.Domain.Entities

@{
    ViewData["Title"] = "Service Request Details";
}

@{
    var inspections =
        ViewBag.ServiceInspections as List<ServiceInspection>
        ?? new List<ServiceInspection>();

    var repairs =
        ViewBag.ServiceRepairs as List<ServiceRepair>
        ?? new List<ServiceRepair>();

    var partsUsed =
        ViewBag.ServicePartsUsed as List<ServicePartUsed>
        ?? new List<ServicePartUsed>();

    var postMaintenanceResult =
        ViewBag.PostMaintenanceResult as PostMaintenanceResult;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Service Request Details</h2>
        <p class="text-muted mb-0">
            Review request information and continue the maintenance workflow.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.ServiceRequestId"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">Inspection History</h5>
        </div>

        <a asp-controller="ServiceInspections"
           asp-action="Create"
           asp-route-serviceRequestId="@Model.ServiceRequestId"
           class="btn btn-sm btn-primary">
            Add Inspection
        </a>
    </div>

    <div class="card-body">

        @if (!inspections.Any())
        {
            <div class="text-muted">
                No inspections have been recorded for this service request.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Observed Problem</th>
                            <th>Diagnosis</th>
                            <th>Root Cause</th>
                            <th>Failure Category</th>
                            <th>Affected Function</th>
                            <th>Result</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var inspection in inspections)
                        {
                            <tr>
                                <td>
                                    @inspection.InspectionDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @inspection.InspectionType
                                </td>

                                <td>
                                    @inspection.ObservedProblem
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(inspection.Diagnosis)
                                        ? "-"
                                        : inspection.Diagnosis)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(inspection.RootCause)
                                        ? "-"
                                        : inspection.RootCause)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(inspection.FailureCategory)
                                        ? "-"
                                        : inspection.FailureCategory)
                                </td>

                                <td>
                                    @(inspection.AffectedFunction != null
                                        ? inspection.AffectedFunction.FunctionCode
                                        : "-")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(inspection.InspectionResult)
                                        ? "-"
                                        : inspection.InspectionResult)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

<div id="repair-history" class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Repair History</h5>
        <a asp-controller="ServiceRepairs" asp-action="Create"
           asp-route-serviceRequestId="@Model.ServiceRequestId"
           class="btn btn-sm btn-primary">Add Repair</a>
    </div>

    <div class="card-body">
        @if (!repairs.Any())
        {
            <div class="text-muted">No repairs have been recorded for this service request.</div>
        }
        else
        {
            @foreach (var repair in repairs)
            {
                <div class="border rounded mb-4">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Engineer</th>
                                    <th>Repair Type</th>
                                    <th>Action Taken</th>
                                    <th>Firmware Before</th>
                                    <th>Firmware After</th>
                                    <th>Configuration Changed</th>
                                    <th>Result</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@repair.RepairDate.ToString("dd/MM/yyyy")</td>
                                    <td>@repair.RepairEngineerName</td>
                                    <td>@repair.RepairType</td>
                                    <td>@repair.ActionTaken</td>
                                    <td>@(repair.FirmwareBefore != null ? repair.FirmwareBefore.Version : "-")</td>
                                    <td>@(repair.FirmwareAfter != null ? repair.FirmwareAfter.Version : "-")</td>
                                    <td>@(repair.ConfigurationChanged ? "Yes" : "No")</td>
                                    <td>@(string.IsNullOrWhiteSpace(repair.RepairResult) ? "-" : repair.RepairResult)</td>
                                    <td>
                                        <a asp-controller="ServicePartsUsed"
                                           asp-action="Create"
                                           asp-route-serviceRepairId="@repair.ServiceRepairId"
                                           class="btn btn-sm btn-outline-primary">
                                            Add Part
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            }
        }
    </div>
</div>


<div id="all-parts-used" class="card mt-4 mb-4">
    <div class="card-header">
        <h5 class="mb-0">All Parts Used</h5>
    </div>

    <div class="card-body">
        @if (!partsUsed.Any())
        {
            <div class="text-muted">
                No parts have been recorded for this service request.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Part Name</th>
                            <th>Part Number</th>
                            <th>Quantity</th>
                            <th>Old Part Serial</th>
                            <th>New Part Serial</th>
                            <th>Repair Date</th>
                            <th>Engineer</th>
                            <th>Repair Type</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var part in partsUsed)
                        {
                            var relatedRepair = repairs
                                .FirstOrDefault(x => x.ServiceRepairId == part.ServiceRepairId);

                            <tr>
                                <td>@part.PartName</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(part.PartNumber)
                                        ? "-"
                                        : part.PartNumber)
                                </td>
                                <td>@part.Quantity</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(part.OldPartSerialNumber)
                                        ? "-"
                                        : part.OldPartSerialNumber)
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(part.NewPartSerialNumber)
                                        ? "-"
                                        : part.NewPartSerialNumber)
                                </td>
                                <td>
                                    @(relatedRepair != null
                                        ? relatedRepair.RepairDate.ToString("dd/MM/yyyy")
                                        : "-")
                                </td>
                                <td>
                                    @(relatedRepair != null
                                        ? relatedRepair.RepairEngineerName
                                        : "-")
                                </td>
                                <td>
                                    @(relatedRepair != null
                                        ? relatedRepair.RepairType
                                        : "-")
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(part.Notes)
                                        ? "-"
                                        : part.Notes)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (postMaintenanceResult != null)
{
    <div id="post-maintenance-result" class="card mt-4 mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Post-Maintenance Result</h5>
            <span class="badge bg-success">@postMaintenanceResult.FinalStatus</span>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Result Date</label>
                    <div>@postMaintenanceResult.ResultDate.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Current Firmware</label>
                    <div>@(postMaintenanceResult.CurrentFirmwareRelease != null ? postMaintenanceResult.CurrentFirmwareRelease.Version : "-")</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Ready For Return</label>
                    <div>@(postMaintenanceResult.ReadyForReturn ? "Yes" : "No")</div>
                </div>

                <div class="col-12 mb-3">
                    <label class="text-muted small">Final Condition</label>
                    <div style="white-space: pre-wrap;">@postMaintenanceResult.FinalCondition</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Firmware Changed</label>
                    <div>@(postMaintenanceResult.FirmwareChanged ? "Yes" : "No")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Configuration Changed</label>
                    <div>@(postMaintenanceResult.ConfigurationChanged ? "Yes" : "No")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Configuration Reference</label>
                    <div>@(string.IsNullOrWhiteSpace(postMaintenanceResult.CurrentConfigurationReference) ? "-" : postMaintenanceResult.CurrentConfigurationReference)</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Components Changed Summary</label>
                    <div>@(string.IsNullOrWhiteSpace(postMaintenanceResult.ComponentsChangedSummary) ? "-" : postMaintenanceResult.ComponentsChangedSummary)</div>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="text-muted small">Functional Status</label>
                    <div>@(string.IsNullOrWhiteSpace(postMaintenanceResult.FunctionalStatus) ? "-" : postMaintenanceResult.FunctionalStatus)</div>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="text-muted small">Communication Status</label>
                    <div>@(string.IsNullOrWhiteSpace(postMaintenanceResult.CommunicationStatus) ? "-" : postMaintenanceResult.CommunicationStatus)</div>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="text-muted small">Meter Reading Status</label>
                    <div>@(string.IsNullOrWhiteSpace(postMaintenanceResult.MeterReadingStatus) ? "-" : postMaintenanceResult.MeterReadingStatus)</div>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="text-muted small">Calibration Status</label>
                    <div>@(string.IsNullOrWhiteSpace(postMaintenanceResult.CalibrationStatus) ? "-" : postMaintenanceResult.CalibrationStatus)</div>
                </div>

                <div class="col-12">
                    <label class="text-muted small">Notes</label>
                    <div style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(postMaintenanceResult.Notes) ? "-" : postMaintenanceResult.Notes)</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">

    <div class="col-lg-8">

        <div class="card mb-4">
            <div class="card-header">
                <strong>Request Information</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Service Request Number</label>
                        <div class="fw-semibold">@Model.ServiceRequestNumber</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Received Date</label>
                        <div>@Model.ReceivedDate.ToString("dd-MMM-yyyy")</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Meter Serial Number</label>
                        <div class="fw-semibold">@Model.MeterSerialNumber</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Customer Reference</label>
                        <div>
                            @(string.IsNullOrWhiteSpace(Model.CustomerReference)
                                ? "-"
                                : Model.CustomerReference)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Project</label>
                        <div>
                            @(Model.Project == null
                                ? "-"
                                : Model.Project.ProjectCode)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Meter Model</label>
                        <div>
                            @(Model.MeterModel == null
                                ? "-"
                                : Model.MeterModel.ModelCode)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Firmware Release</label>
                        <div>
                            @(Model.FirmwareRelease == null
                                ? "-"
                                : Model.FirmwareRelease.Version)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Production Batch</label>
                        <div>
                            @(Model.ProductionBatch == null
                                ? "-"
                                : Model.ProductionBatch.BatchNumber)
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <strong>Customer Complaint</strong>
            </div>

            <div class="card-body">
                <div style="white-space: pre-wrap;">@Model.CustomerComplaint</div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <strong>Condition On Receipt</strong>
            </div>

            <div class="card-body">
                <div style="white-space: pre-wrap;">
                    @(string.IsNullOrWhiteSpace(Model.ConditionOnReceipt)
                        ? "-"
                        : Model.ConditionOnReceipt)
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Notes</strong>
            </div>

            <div class="card-body">
                <div style="white-space: pre-wrap;">
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                        ? "-"
                        : Model.Notes)
                </div>
            </div>
        </div>

    </div>

    <div class="col-lg-4">

        <div class="card mb-4">
            <div class="card-header">
                <strong>Current Status</strong>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <label class="text-muted small">Status</label>

                    <div class="mt-1">
                        <span class="badge bg-info text-dark">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small">Priority</label>

                    <div class="mt-1">
                        @if (Model.Priority == "Critical")
                        {
                            <span class="badge bg-danger">Critical</span>
                        }
                        else if (Model.Priority == "High")
                        {
                            <span class="badge bg-warning text-dark">High</span>
                        }
                        else if (Model.Priority == "Low")
                        {
                            <span class="badge bg-secondary">Low</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Normal</span>
                        }
                    </div>
                </div>

                <div>
                    <label class="text-muted small">Warranty Status</label>

                    <div>
                        @(string.IsNullOrWhiteSpace(Model.WarrantyStatus)
                            ? "-"
                            : Model.WarrantyStatus)
                    </div>
                </div>

            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Maintenance Workflow</strong>
            </div>

            <div class="card-body">

                <div class="d-grid gap-2">

                    <a asp-controller="ServiceInspections"
                       asp-action="Create"
                       asp-route-serviceRequestId="@Model.ServiceRequestId"
                       class="btn btn-outline-primary">
                        Inspection
                    </a>

                    <a asp-controller="ServiceRepairs"
                       asp-action="Create"
                       asp-route-serviceRequestId="@Model.ServiceRequestId"
                       class="btn btn-outline-primary">
                        Repair
                    </a>

                    <a href="#all-parts-used"
                       class="btn btn-outline-primary">
                        Parts Used
                    </a>

                    @if (postMaintenanceResult == null)
                    {
                        <a asp-controller="PostMaintenanceResults"
                           asp-action="Create"
                           asp-route-serviceRequestId="@Model.ServiceRequestId"
                           class="btn btn-success">
                            Post-Maintenance Result
                        </a>
                    }
                    else
                    {
                        <a href="#post-maintenance-result"
                           class="btn btn-success">
                            View Post-Maintenance Result
                        </a>
                    }

                </div>

                <small class="text-muted d-block mt-3">
                    Workflow actions will be enabled as the
                    after-sales stages are implemented.
                </small>

            </div>
        </div>

    </div>

</div>
