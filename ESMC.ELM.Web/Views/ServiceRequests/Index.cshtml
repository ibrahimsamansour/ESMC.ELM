@model IEnumerable<ESMC.ELM.Domain.Entities.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Service Requests</h2>
        <p class="text-muted mb-0">
            Manage after-sales and maintenance service requests.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        New Service Request
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No service requests have been created yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Request Number</th>
                            <th>Received Date</th>
                            <th>Serial Number</th>
                            <th>Project</th>
                            <th>Meter Model</th>
                            <th>Production Batch</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.ServiceRequestNumber
                                    </strong>
                                </td>

                                <td>
                                    @item.ReceivedDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @item.MeterSerialNumber
                                </td>

                                <td>
                                    @(item.Project == null
                                        ? "-"
                                        : item.Project.ProjectCode)
                                </td>

                                <td>
                                    @(item.MeterModel == null
                                        ? "-"
                                        : item.MeterModel.ModelCode)
                                </td>

                                <td>
                                    @(item.ProductionBatch == null
                                        ? "-"
                                        : item.ProductionBatch.BatchNumber)
                                </td>

                                <td>
                                    @if (item.Priority == "Critical")
                                    {
                                        <span class="badge bg-danger">Critical</span>
                                    }
                                    else if (item.Priority == "High")
                                    {
                                        <span class="badge bg-warning text-dark">High</span>
                                    }
                                    else if (item.Priority == "Low")
                                    {
                                        <span class="badge bg-secondary">Low</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Normal</span>
                                    }
                                </td>

                                <td>
                                    @item.Status
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details"
                                           asp-route-id="@item.ServiceRequestId"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ServiceRequestId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>
