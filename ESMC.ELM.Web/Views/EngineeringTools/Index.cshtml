@model IEnumerable<ESMC.ELM.Domain.Entities.EngineeringTool>

@{
    ViewData["Title"] = "Engineering Tools";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Engineering Tools</h2>
        <p class="text-muted mb-0">
            Manage engineering software and tools used with meter products.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Engineering Tool
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No engineering tools have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Tool Code</th>
                            <th>Tool Name</th>
                            <th>Type</th>
                            <th>Vendor</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.ToolCode</strong>
                                </td>

                                <td>@item.ToolName</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.ToolType
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Vendor)
                                        ? "-"
                                        : item.Vendor)
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@item.EngineeringToolId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>