@model ESMC.ELM.Web.Models.EditEngineeringToolViewModel

@{
    ViewData["Title"] = "Edit Engineering Tool";
}

<div class="mb-4">
    <h2>Edit Engineering Tool</h2>
    <p class="text-muted mb-0">
        Update the engineering tool information.
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="EngineeringToolId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label asp-for="ToolCode"
                           class="form-label"></label>

                    <input asp-for="ToolCode"
                           class="form-control" />

                    <span asp-validation-for="ToolCode"
                          class="text-danger"></span>
                </div>

                <div class="col-md-8 mb-3">
                    <label asp-for="ToolName"
                           class="form-label"></label>

                    <input asp-for="ToolName"
                           class="form-control" />

                    <span asp-validation-for="ToolName"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="ToolType"
                           class="form-label"></label>

                    <select asp-for="ToolType"
                            class="form-select">

                        <option value="Configuration">
                            Configuration
                        </option>

                        <option value="MeterView">
                            Meter View
                        </option>

                        <option value="Installation">
                            Installation
                        </option>

                        <option value="Calibration">
                            Calibration
                        </option>

                        <option value="Diagnostic">
                            Diagnostic
                        </option>

                        <option value="FirmwareUpgrade">
                            Firmware Upgrade
                        </option>

                        <option value="Testing">
                            Testing
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                    <span asp-validation-for="ToolType"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Vendor"
                           class="form-label"></label>

                    <input asp-for="Vendor"
                           class="form-control" />

                    <span asp-validation-for="Vendor"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="mb-3">

                <label asp-for="Description"
                       class="form-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>

            </div>

            <div class="form-check mb-4">

                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                    Active
                </label>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.EngineeringToolId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}