@model ESMC.ELM.Domain.Entities.MeterModel

@{
    ViewData["Title"] = "Meter Model Details";

    var communicationInterfaces =
        ViewBag.CommunicationInterfaces as List<string>;
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Meter Model Details</h2>
                <p class="text-muted mb-0">
                    View meter hardware model and electrical specifications.
                </p>
            </div>

            <div>
                <a asp-action="Edit"
                   asp-route-id="@Model.MeterModelId"
                   class="btn btn-primary">
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <h4 class="mb-4">
                    @Model.ModelCode
                </h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Commercial Name</label>
                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.CommercialName)
                                ? "-"
                                : Model.CommercialName)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Model Family</label>
                        <div>
                            @(string.IsNullOrWhiteSpace(Model.ModelFamily)
                                ? "-"
                                : Model.ModelFamily)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Meter Type</label>
                        <div>
                            @Model.MeterType
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Phase Type</label>
                        <div>
                            @Model.PhaseType
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Connection Type</label>
                        <div>
                            @(string.IsNullOrWhiteSpace(Model.ConnectionType)
                                ? "-"
                                : Model.ConnectionType)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Communication Interfaces</label>

                        <div>
                            @if (communicationInterfaces != null &&
                            communicationInterfaces.Any())
                            {
                                foreach (var interfaceName in communicationInterfaces)
                                {
                                    <span class="badge bg-info text-dark me-1 mb-1">
                                        @interfaceName
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    No communication interfaces assigned.
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Reference Voltage</label>
                        <div>
                            @Model.ReferenceVoltage
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Basic Current (Ib)</label>
                        <div>
                            @Model.BasicCurrent.ToString("0.###") A
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Maximum Current (Imax)</label>
                        <div>
                            @Model.MaximumCurrent.ToString("0.###") A
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Active Accuracy Class</label>
                        <div>
                            @Model.ActiveAccuracyClass
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Reactive Accuracy Class</label>
                        <div>
                            @(string.IsNullOrWhiteSpace(Model.ReactiveAccuracyClass)
                                ? "-"
                                : Model.ReactiveAccuracyClass)
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Frequency</label>
                        <div>
                            @Model.Frequency
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted">Product Status</label>
                        <div>
                            <span class="badge bg-primary">
                                @Model.ProductStatus
                            </span>
                        </div>
                    </div>

                    <div class="col-12 mt-2">
                        <hr />

                        <label class="text-muted">Description</label>

                        <div class="mt-1">
                            @if (string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <span class="text-muted">
                                    No description provided.
                                </span>
                            }
                            else
                            {
                                @Model.Description
                            }
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>