@model ESMC.ELM.Web.Models.MeterModelCommunicationInterfacesViewModel

@{
    ViewData["Title"] = "Meter Model Communication Interfaces";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Communication Interfaces</h2>
                <p class="text-muted mb-0">
                    Configure communication interfaces for meter model
                    <strong>@Model.MeterModelCode</strong>.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="CommunicationInterfaces"
                      method="post">

                    <input asp-for="MeterModelId"
                           type="hidden" />

                    @if (!Model.CommunicationInterfaces.Any())
                    {
                        <div class="alert alert-warning mb-0">
                            No communication interfaces are available.
                            Please add communication interfaces first.
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">

                            @foreach (var item in Model.CommunicationInterfaces)
                            {
                                var interfaceId = long.Parse(item.Value);

                                <div class="form-check mb-2">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedCommunicationInterfaceIds"
                                           value="@interfaceId"
                                           id="interface_@interfaceId"
                                    @(Model.SelectedCommunicationInterfaceIds.Contains(interfaceId)
                                        ? "checked"
                                        : "") />

                                    <label class="form-check-label"
                                           for="interface_@interfaceId">
                                        @item.Text
                                    </label>

                                </div>
                            }

                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Save Communication Interfaces
                            </button>
                        </div>
                    }

                </form>

            </div>
        </div>

    </div>
</div>