@model ESMC.ELM.Web.Models.EditProductionOrderConfigurationViewModel

@{
    ViewData["Title"] = "Edit Configuration Allocation";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Edit Configuration Allocation</h2>
                <p class="text-muted mb-0">
                    Update the allocated quantity for this production configuration.
                </p>
            </div>

            <a asp-action="Details"
               asp-route-id="@Model.ProductionOrderId"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card mb-3">
            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">
                            Production Order
                        </label>

                        <div class="fw-semibold">
                            @Model.ProductionOrderNumber
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">
                            Project Configuration
                        </label>

                        <div class="fw-semibold">
                            @Model.ConfigurationDisplay
                        </div>
                    </div>

                </div>

                <hr />

                <div class="row text-center">

                    <div class="col-md-3 mb-3">
                        <div class="text-muted small">
                            Order Quantity
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Model.OrderQuantity.ToString("N0")
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <div class="text-muted small">
                            Other Allocations
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Model.OtherAllocatedQuantity.ToString("N0")
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <div class="text-muted small">
                            Already Batched
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Model.BatchedQuantity.ToString("N0")
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <div class="text-muted small">
                            Maximum Allowed
                        </div>

                        <div class="fs-5 fw-semibold">
                            @Model.MaximumAllowedQuantity.ToString("N0")
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="EditConfiguration"
                      method="post">

                    <input asp-for="ProductionOrderConfigurationId"
                           type="hidden" />

                    <input asp-for="ProductionOrderId"
                           type="hidden" />

                    <input asp-for="ProjectConfigurationId"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="PlannedQuantity"
                               class="form-label"></label>

                        <input asp-for="PlannedQuantity"
                               type="number"
                               min="@Model.BatchedQuantity"
                               max="@Model.MaximumAllowedQuantity"
                               class="form-control" />

                        <span asp-validation-for="PlannedQuantity"
                              class="text-danger"></span>

                        <div class="form-text">
                            Allowed range:
                            @Model.BatchedQuantity.ToString("N0")
                            to
                            @Model.MaximumAllowedQuantity.ToString("N0")
                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Notes"
                               class="form-label"></label>

                        <textarea asp-for="Notes"
                                  rows="4"
                                  class="form-control"></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger"></span>

                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Save Allocation
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}