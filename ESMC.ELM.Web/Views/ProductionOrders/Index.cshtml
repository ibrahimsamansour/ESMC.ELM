@model IEnumerable<ESMC.ELM.Domain.Entities.ProductionOrder>

@{
    ViewData["Title"] = "Production Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Production Orders</h2>
        <p class="text-muted mb-0">
            Manage and track production orders for engineering projects.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Production Order
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No production orders have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Order Number</th>
                            <th>Project</th>
                            <th>Order Date</th>
                            <th>Quantity</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Requested Start</th>
                            <th>Requested Completion</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.ProductionOrderNumber
                                    </strong>
                                </td>

                                <td>
                                    @item.Project.ProjectCode
                                </td>

                                <td>
                                    @item.OrderDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @item.PlannedQuantity.ToString("N0")
                                </td>

                                <td>
                                    @if (item.Priority == "Critical")
                                    {
                                        <span class="badge bg-danger">
                                            Critical
                                        </span>
                                    }
                                    else if (item.Priority == "High")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            High
                                        </span>
                                    }
                                    else if (item.Priority == "Normal")
                                    {
                                        <span class="badge bg-primary">
                                            Normal
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Low
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (item.Status == "InProduction")
                                    {
                                        <span class="badge bg-primary">
                                            In Production
                                        </span>
                                    }
                                    else if (item.Status == "Released")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Released
                                        </span>
                                    }
                                    else if (item.Status == "OnHold")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            On Hold
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Planned
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.RequestedStartDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>
                                    @(item.RequestedCompletionDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td class="text-end text-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@item.ProductionOrderId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ProductionOrderId"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>