@model ESMC.ELM.Domain.Entities.ProductionOrder

@using ESMC.ELM.Domain.Entities

@{
    ViewData["Title"] = "Production Order Details";

    var configurations =
        ViewBag.Configurations as
            List<ProductionOrderConfiguration>
        ?? new List<ProductionOrderConfiguration>();

    var allocatedQuantity =
        configurations.Sum(x => x.PlannedQuantity);

    var remainingQuantity =
        Model.PlannedQuantity - allocatedQuantity;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Production Order Details</h2>
        <p class="text-muted mb-0">
            View production order information.
        </p>
    </div>

    <div>
        <a asp-action="Edit"
           asp-route-id="@Model.ProductionOrderId"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">
                <strong>Production Order Number</strong>
                <div>@Model.ProductionOrderNumber</div>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Project</strong>
                <div>
                    @Model.Project.ProjectCode -
                    @Model.Project.ProjectName
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Order Date</strong>
                <div>
                    @Model.OrderDate.ToString("dd-MMM-yyyy")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Planned Quantity</strong>
                <div>
                    @Model.PlannedQuantity.ToString("N0")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Priority</strong>
                <div>@Model.Priority</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Status</strong>
                <div>@Model.Status</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Requested Start Date</strong>
                <div>
                    @(Model.RequestedStartDate?
                                        .ToString("dd-MMM-yyyy") ?? "-")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Requested Completion Date</strong>
                <div>
                    @(Model.RequestedCompletionDate?
                                        .ToString("dd-MMM-yyyy") ?? "-")
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Actual Completion Date</strong>
                <div>
                    @(Model.ActualCompletionDate?
                                        .ToString("dd-MMM-yyyy") ?? "-")
                </div>
            </div>

            <div class="col-12 mb-3">
                <strong>Notes</strong>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.Notes)
                                        ? "-"
                                        : Model.Notes)
                </div>
            </div>

        </div>

        <hr />

        <div class="row text-muted small">

            <div class="col-md-6">
                Created:
                @Model.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
            </div>

            <div class="col-md-6">
                Last Updated:
                @(Model.UpdatedAt?
                                .ToString("dd-MMM-yyyy HH:mm") ?? "-")
            </div>

        </div>

    </div>
</div>

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">

        <div>
            <h5 class="mb-0">
                Project Configurations
            </h5>
        </div>

        @if (remainingQuantity > 0)
        {
            <a asp-action="AddConfiguration"
               asp-route-id="@Model.ProductionOrderId"
               class="btn btn-sm btn-primary">
                Add Configuration
            </a>
        }

    </div>

    <div class="card-body">

        <div class="row mb-4">

            <div class="col-md-4">
                <div class="border rounded p-3">
                    <div class="text-muted small">
                        Order Quantity
                    </div>

                    <strong>
                        @Model.PlannedQuantity.ToString("N0")
                    </strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded p-3">
                    <div class="text-muted small">
                        Allocated Quantity
                    </div>

                    <strong>
                        @allocatedQuantity.ToString("N0")
                    </strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded p-3">
                    <div class="text-muted small">
                        Remaining Quantity
                    </div>

                    <strong>
                        @remainingQuantity.ToString("N0")
                    </strong>
                </div>
            </div>

        </div>

        @if (remainingQuantity == 0)
        {
            <div class="alert alert-success">
                The full Production Order quantity has been
                allocated to Project Configurations.
            </div>
        }

        @if (!configurations.Any())
        {
            <div class="alert alert-info mb-0">
                No Project Configurations have been added
                to this Production Order yet.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Configuration Code</th>
                            <th>Configuration Name</th>
                            <th>Planned Quantity</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in configurations)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.ProjectConfiguration.ConfigurationCode
                                    </strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                                                item.ProjectConfiguration.ConfigurationName)
                                                                ? "-"
                                                                : item.ProjectConfiguration.ConfigurationName)
                                                                                                          </td>

                                <td>
                                    @item.PlannedQuantity.ToString("N0")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Notes)
                                                                ? "-"
                                                                : item.Notes)
                        </td>

                                <td class="text-end">
                                    <a asp-action="EditConfiguration"
                                       asp-route-id="@item.ProductionOrderConfigurationId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit Allocation
                                    </a>
                                </td>

                            </tr>
                                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>