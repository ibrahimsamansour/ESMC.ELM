@model ESMC.ELM.Web.Models.AddProductionOrderConfigurationViewModel

@{
    ViewData["Title"] = "Add Project Configuration";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>Add Project Configuration</h2>
                <p class="text-muted mb-0">
                    Production Order:
                    <strong>@Model.ProductionOrderNumber</strong>
                </p>
            </div>

            <a asp-action="Details"
               asp-route-id="@Model.ProductionOrderId"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>

        <div class="card">
            <div class="card-body">

                <form asp-action="AddConfiguration" method="post">

                    <input asp-for="ProductionOrderId"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjectConfigurationId"
                               class="form-label"></label>

                        <select asp-for="ProjectConfigurationId"
                                asp-items="Model.ProjectConfigurations"
                                class="form-select">

                            <option value="">
                                -- Select Project Configuration --
                            </option>

                        </select>

                        <span asp-validation-for="ProjectConfigurationId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PlannedQuantity"
                               class="form-label"></label>

                        <input asp-for="PlannedQuantity"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span asp-validation-for="PlannedQuantity"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes"
                               class="form-label"></label>

                        <textarea asp-for="Notes"
                                  rows="4"
                                  class="form-control"></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Add Configuration
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}