@model IEnumerable<ESMC.ELM.Domain.Entities.TestCase>

@{
    ViewData["Title"] = "Test Cases";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Test Cases</h2>
        <p class="text-muted mb-0">
            Manage engineering and validation test cases.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Test Case
    </a>
</div>

<div class="card">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">
                No test cases have been added yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Title</th>
                            <th>Project</th>
                            <th>Requirement</th>
                            <th>Function</th>
                            <th>Type</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th style="width: 160px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @item.TestCaseCode
                                    </strong>
                                </td>

                                <td>
                                    @item.Title
                                </td>

                                <td>
                                    <strong>
                                        @item.Project.ProjectCode
                                    </strong>
                                </td>

                                <td>
                                    @if (item.Requirement != null)
                                    {
                                        <span>
                                            @item.Requirement.RequirementCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.ProductFunction != null)
                                    {
                                        <span>
                                            @item.ProductFunction.FunctionCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.TestType
                                </td>

                                <td>
                                    @if (string.Equals(
                                                                item.Priority,
                                                                "Critical",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">
                                            Critical
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Priority,
                                    "High",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            High
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Priority,
                                    "Medium",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info text-dark">
                                            Medium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Priority
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (string.Equals(
                                                                item.Status,
                                                                "Approved",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Status,
                                    "Draft",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-secondary">
                                            Draft
                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Status,
                                    "Obsolete",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Obsolete
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.TestCaseId"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.TestCaseId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>